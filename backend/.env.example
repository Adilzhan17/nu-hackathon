# Read from the working directory; environment variables take precedence.
HTTP_ADDR=127.0.0.1:8080
LOG_LEVEL=info

# Required: choose a private value of at least 16 bytes. Never commit it.
API_KEY=

# Implementation defaults; the case does not mandate these individual limits.
UPLOAD_MAX_BYTES=524288000
UPLOAD_TIMEOUT=110s
ANALYSIS_TIMEOUT=270s
SHUTDOWN_TIMEOUT=15s
WORKERS=1
QUEUE_SIZE=8
MAX_UPLOADS=2

# Local job database, video storage and result retention.
STORAGE_DIR=./storage
JOB_RETENTION=24h
CLEANUP_INTERVAL=10m

# Swagger UI origins. The Next.js server proxy does not require browser CORS.
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
