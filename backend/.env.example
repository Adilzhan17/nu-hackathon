# Proposed settings; config loading and the backend are not implemented yet.
APP_ENV=local
HTTP_ADDR=:8080
LOG_LEVEL=info

# Set a private value before running the future API. Never commit a real key.
API_KEY=

# Team defaults, not limits specified by the organizers.
UPLOAD_MAX_BYTES=67108864
ANALYSIS_TIMEOUT=270s
SHUTDOWN_TIMEOUT=15s

# Media and model weights remain inside the local deployment.
STORAGE_DIR=./storage
MODEL_DIR=./weights
