{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Offline visual action proposal",
  "type": "object",
  "required": [
    "confidence",
    "end_sec",
    "evidence_timestamps",
    "group_id",
    "model_id",
    "model_revision",
    "objects",
    "observed_action",
    "review_status",
    "start_sec",
    "uncertainty_reason",
    "video"
  ],
  "properties": {
    "start_sec": {
      "type": "number",
      "minimum": 0
    },
    "video": {
      "type": "string"
    },
    "end_sec": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Uncalibrated model self-rating; not a probability."
    },
    "evidence_timestamps": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "number",
        "minimum": 0
      }
    },
    "uncertainty_reason": {
      "type": "string"
    },
    "group_id": {
      "type": "string"
    },
    "objects": {
      "type": "array",
      "items": {
        "enum": [
          "cash",
          "safe",
          "key",
          "document",
          "stamp",
          "person",
          "cash_counter",
          "unidentified_item",
          "computer",
          "bag"
        ]
      }
    },
    "review_status": {
      "const": "proposed"
    },
    "model_id": {
      "type": "string"
    },
    "observed_action": {
      "enum": [
        "cash_received",
        "cash_transferred",
        "cash_counting",
        "cash_placed",
        "cash_removed",
        "safe_opening",
        "safe_closing",
        "leave_workstation",
        "key_handling",
        "document_handling",
        "stamp_handling",
        "unclear_action",
        "cash_unpacking",
        "cash_bundling",
        "cash_counter_loading",
        "safe_locking",
        "document_transfer",
        "document_stamping",
        "return_to_workstation",
        "computer_work",
        "person_enters",
        "person_leaves",
        "object_handling"
      ]
    },
    "model_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "split": {
      "const": "train"
    },
    "confidence_kind": {
      "const": "uncalibrated_model_self_rating"
    },
    "candidate_id": {
      "type": "string"
    },
    "proposal_id": {
      "type": "string"
    },
    "source_observation_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "conflict_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false,
  "$comment": "schema.py also validates duration bounds, frame PTS, model revision, frozen split/group, and temporal sequence."
}